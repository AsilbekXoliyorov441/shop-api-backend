# PostgreSQL ulanishi (faqat lokal ishga tushirishda; docker-compose ichida avtomatik yasaladi)
DATABASE_URL=postgresql://shop:shop@localhost:5432/shop

# Baza paroli (docker-compose). Faqat harf va raqam: openssl rand -hex 16
# Diqqat: baza birinchi marta yaratilganda o'rnatiladi, keyin bu yerda o'zgartirish parolni o'zgartirmaydi
POSTGRES_PASSWORD=shop

# Majburiy: kamida 32 belgili tasodifiy satr. Masalan: openssl rand -hex 32
# NODE_ENV=production bo'lsa (Docker'da shunday) zaif kalit bilan server ishga tushmaydi
JWT_SECRET=change-me

# API tashqaridan ko'rinadigan manzil (yuklangan rasmlar URL'i shundan yasaladi)
PUBLIC_URL=http://localhost:3000

PORT=3000
# Portni qaysi interfeysda ochish. Caddy (HTTPS) ishlatilsa 127.0.0.1 qiling
BIND=0.0.0.0

# HTTPS uchun domen (docker compose --profile https). DNS A yozuvi serverga qaragan bo'lishi kerak
# DOMAIN=api.example.uz

# Access token muddati. Qisqa bo'lgani ma'qul: o'quvchilar refresh oqimini yozadi
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Bitta IP uchun daqiqasiga so'rovlar soni (butun sinf bitta IP ortida bo'lishi mumkin)
RATE_LIMIT=600
# Qaysi saytlardan brauzer orqali so'rov yuborish mumkin. * = hamma joydan (o'quv API uchun qulay).
# Cheklash uchun: CORS_ORIGINS=http://localhost:5173,https://my-shop.vercel.app
CORS_ORIGINS=*
